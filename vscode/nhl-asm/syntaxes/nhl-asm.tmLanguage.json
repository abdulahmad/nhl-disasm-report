{
  "name": "NHL assembly (68000 + 65816)",
  "scopeName": "source.nhl-asm",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#label"
    },
    {
      "include": "#directive"
    },
    {
      "include": "#mnemonic"
    },
    {
      "include": "#macrocall"
    },
    {
      "include": "#operand"
    }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.line.semicolon.nhl-asm",
          "match": ";.*$"
        },
        {
          "name": "comment.line.star.nhl-asm",
          "match": "^\\*.*$"
        }
      ]
    },
    "label": {
      "patterns": [
        {
          "match": "(?i)^([A-Za-z_@][A-Za-z0-9_@]*)(?=\\s+macro\\b)",
          "name": "entity.name.function.macro.nhl-asm"
        },
        {
          "match": "(?i)^(\\s*macro\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.directive.nhl-asm"
            },
            "2": {
              "name": "entity.name.function.macro.nhl-asm"
            }
          }
        },
        {
          "match": "(?i)^\\s*(!?[.?]?[A-Za-z_@][A-Za-z0-9_@.]*)(?=\\s+(?:equ|set|rs\\.[bwl])\\b|\\s*=(?!=))",
          "name": "variable.other.constant.nhl-asm"
        },
        {
          "match": "^\\s*([.?]?[A-Za-z_@][A-Za-z0-9_@.]*)(:)",
          "captures": {
            "1": {
              "name": "entity.name.function.label.nhl-asm"
            },
            "2": {
              "name": "punctuation.separator.nhl-asm"
            }
          }
        },
        {
          "match": "^([.?]?[A-Za-z_@][A-Za-z0-9_@.]*)(?=\\s|$|;)",
          "name": "entity.name.function.label.nhl-asm"
        }
      ]
    },
    "directive": {
      "patterns": [
        {
          "match": "(?i)(?<![\\w.$#!])(include|incbin|incsrc)(\\s+)([^\\s;,\"']+)",
          "captures": {
            "1": {
              "name": "keyword.control.directive.nhl-asm"
            },
            "3": {
              "name": "string.unquoted.path.nhl-asm"
            }
          }
        },
        {
          "name": "keyword.control.directive.nhl-asm",
          "match": "(?i)(?<![\\w.$#!])(?:include|incbin|org|even|cnop|align|opt|section|xdef|xref|end|rsset|rsreset|equ|set|macro|endm|mexit|if|ifd|ifnd|ifeq|ifne|else|elseif|endif|rept|endr|dc|dcb|ds|rs|db|dw|dl|dd|incsrc|incbin|org|base|pad|padbyte|fill|fillbyte|skip|lorom|hirom|exlorom|norom|sa1rom|arch|asar|math|print|assert|warnpc|warn|error|check|bankcross|if|elseif|else|endif|while|endwhile|macro|endmacro|namespace|pushpc|pullpc|pushbase|pullbase|struct|endstruct|freecode|freedata|autoclean|cleartable|table|cleartable|optimize|bank|function|undef|def)(?:\\.[bwls])?(?![\\w])"
        }
      ]
    },
    "mnemonic": {
      "patterns": [
        {
          "name": "keyword.other.mnemonic.nhl-asm",
          "match": "(?i)(?<![\\w.$#!<?])(?:abcd|add[aiqx]?|and[i]?|as[lr]|b(?:cc|cs|eq|ge|gt|hi|le|ls|lt|mi|ne|pl|vc|vs|ra|sr|chg|clr|set|tst)|chk|clr|cmp[aim]?|db(?:cc|cs|eq|f|ge|gt|hi|le|ls|lt|mi|ne|pl|t|vc|vs|ra)|div[su]|eor[i]?|exg|ext|illegal|jmp|jsr|lea|link|ls[lr]|move[acmpq]?|mul[su]|nbcd|neg[x]?|nop|not|or[i]?|pea|reset|ro[lr]|rox[lr]|rt[res]|sbcd|s(?:cc|cs|eq|f|ge|gt|hi|le|ls|lt|mi|ne|pl|t|vc|vs)|stop|sub[aiqx]?|swap|tas|trap[v]?|tst|unlk|adc|and|asl|bcc|bcs|beq|bit|bmi|bne|bpl|bra|brk|brl|bvc|bvs|clc|cld|cli|clv|cmp|cop|cpx|cpy|dec|dex|dey|eor|inc|inx|iny|jml|jmp|jsl|jsr|lda|ldx|ldy|lsr|mvn|mvp|nop|ora|pea|pei|per|pha|phb|phd|phk|php|phx|phy|pla|plb|pld|plp|plx|ply|rep|rol|ror|rti|rtl|rts|sbc|sec|sed|sei|sep|sta|stp|stx|sty|stz|tax|tay|tcd|tcs|tdc|trb|tsb|tsc|tsx|txa|txs|txy|tya|tyx|wai|wdm|xba|xce|bge|blt|cpa|dea|ina|swa|tad|tda|tas|tsa)(?:\\.[bwls])?(?![\\w])"
        }
      ]
    },
    "macrocall": {
      "patterns": [
        {
          "name": "entity.name.function.macro.nhl-asm",
          "match": "%[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "begin": "^(\\s+)(?!(?i:(?:include|incbin|org|even|cnop|align|opt|section|xdef|xref|end|rsset|rsreset|equ|set|macro|endm|mexit|if|ifd|ifnd|ifeq|ifne|else|elseif|endif|rept|endr|dc|dcb|ds|rs|db|dw|dl|dd|incsrc|incbin|org|base|pad|padbyte|fill|fillbyte|skip|lorom|hirom|exlorom|norom|sa1rom|arch|asar|math|print|assert|warnpc|warn|error|check|bankcross|if|elseif|else|endif|while|endwhile|macro|endmacro|namespace|pushpc|pullpc|pushbase|pullbase|struct|endstruct|freecode|freedata|autoclean|cleartable|table|cleartable|optimize|bank|function|undef|def|abcd|add[aiqx]?|and[i]?|as[lr]|b(?:cc|cs|eq|ge|gt|hi|le|ls|lt|mi|ne|pl|vc|vs|ra|sr|chg|clr|set|tst)|chk|clr|cmp[aim]?|db(?:cc|cs|eq|f|ge|gt|hi|le|ls|lt|mi|ne|pl|t|vc|vs|ra)|div[su]|eor[i]?|exg|ext|illegal|jmp|jsr|lea|link|ls[lr]|move[acmpq]?|mul[su]|nbcd|neg[x]?|nop|not|or[i]?|pea|reset|ro[lr]|rox[lr]|rt[res]|sbcd|s(?:cc|cs|eq|f|ge|gt|hi|le|ls|lt|mi|ne|pl|t|vc|vs)|stop|sub[aiqx]?|swap|tas|trap[v]?|tst|unlk|adc|and|asl|bcc|bcs|beq|bit|bmi|bne|bpl|bra|brk|brl|bvc|bvs|clc|cld|cli|clv|cmp|cop|cpx|cpy|dec|dex|dey|eor|inc|inx|iny|jml|jmp|jsl|jsr|lda|ldx|ldy|lsr|mvn|mvp|nop|ora|pea|pei|per|pha|phb|phd|phk|php|phx|phy|pla|plb|pld|plp|plx|ply|rep|rol|ror|rti|rtl|rts|sbc|sec|sed|sei|sep|sta|stp|stx|sty|stz|tax|tay|tcd|tcs|tdc|trb|tsb|tsc|tsx|txa|txs|txy|tya|tyx|wai|wdm|xba|xce|bge|blt|cpa|dea|ina|swa|tad|tda|tas|tsa)(?:\\.[bwls])?)(?:\\s|$|;))([A-Za-z_@][A-Za-z0-9_@]*)(?=\\s|$|;)",
          "beginCaptures": {
            "2": {
              "name": "entity.name.function.macro.nhl-asm"
            }
          },
          "end": "(?=;)|$",
          "patterns": [
            {
              "include": "#comment"
            },
            {
              "name": "constant.numeric.hex.nhl-asm",
              "match": "(?<![\\w.$@])(?=[0-9A-Fa-f]*[0-9])[0-9A-Fa-f]+(?![\\w])"
            },
            {
              "include": "#operand"
            }
          ]
        }
      ]
    },
    "operand": {
      "patterns": [
        {
          "name": "storage.modifier.size.nhl-asm",
          "match": "(?<=[)\\]])\\.[bwl](?![\\w])"
        },
        {
          "name": "string.quoted.double.nhl-asm",
          "begin": "\"",
          "end": "\""
        },
        {
          "name": "string.quoted.single.nhl-asm",
          "begin": "'",
          "end": "'"
        },
        {
          "name": "variable.parameter.macro.nhl-asm",
          "match": "<[A-Za-z_][A-Za-z0-9_]*>"
        },
        {
          "name": "variable.language.register.nhl-asm",
          "match": "(?i)(?<![\\w.$])(?:[da][0-7]|sp|sr|ccr|pc|usp|[axy])(?![\\w])"
        },
        {
          "name": "constant.numeric.hex.nhl-asm",
          "match": "\\$[0-9A-Fa-f]+"
        },
        {
          "name": "constant.numeric.binary.nhl-asm",
          "match": "%[01]+(?![\\w])"
        },
        {
          "name": "constant.numeric.decimal.nhl-asm",
          "match": "(?<![\\w.$])\\d+(?![\\w])"
        },
        {
          "name": "support.constant.local-label.nhl-asm",
          "match": "(?<![\\w)\\]])[.?][A-Za-z0-9_]+"
        },
        {
          "name": "variable.other.define.nhl-asm",
          "match": "![A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "keyword.operator.nhl-asm",
          "match": "<<|>>|[-+*/&|^~#<>=!]"
        },
        {
          "name": "variable.other.nhl-asm",
          "match": "[A-Za-z_@][A-Za-z0-9_@]*"
        }
      ]
    }
  }
}