{
  "name": "NHL 65816 (asar)",
  "scopeName": "source.nhl-65816",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#label"
    },
    {
      "include": "#directive"
    },
    {
      "include": "#mnemonic"
    },
    {
      "include": "#operand"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.semicolon.nhl-65816",
      "match": ";.*$"
    },
    "label": {
      "patterns": [
        {
          "match": "(?i)^(\\s*macro\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.directive.nhl-65816"
            },
            "2": {
              "name": "entity.name.function.macro.nhl-65816"
            }
          }
        },
        {
          "match": "^\\s*([.?]?[A-Za-z_][A-Za-z0-9_]*)(:)",
          "captures": {
            "1": {
              "name": "entity.name.function.label.nhl-65816"
            },
            "2": {
              "name": "punctuation.separator.nhl-65816"
            }
          }
        },
        {
          "match": "^\\s*(!?[A-Za-z_][A-Za-z0-9_]*)(?=\\s*=(?!=))",
          "name": "variable.other.constant.nhl-65816"
        }
      ]
    },
    "directive": {
      "patterns": [
        {
          "match": "(?i)(?<![\\w.$#!])(incsrc|incbin)(\\s+)([^\\s;,\"']+)",
          "captures": {
            "1": {
              "name": "keyword.control.directive.nhl-65816"
            },
            "3": {
              "name": "string.unquoted.path.nhl-65816"
            }
          }
        },
        {
          "name": "keyword.control.directive.nhl-65816",
          "match": "(?i)(?<![\\w.$#!])(?:db|dw|dl|dd|incsrc|incbin|org|base|pad|padbyte|fill|fillbyte|skip|lorom|hirom|exlorom|norom|sa1rom|arch|asar|math|print|assert|warnpc|warn|error|check|bankcross|if|elseif|else|endif|while|endwhile|macro|endmacro|namespace|pushpc|pullpc|pushbase|pullbase|struct|endstruct|freecode|freedata|autoclean|cleartable|table|cleartable|optimize|bank|function|undef|def)(?![\\w])"
        },
        {
          "name": "entity.name.function.macro.nhl-65816",
          "match": "%[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "mnemonic": {
      "patterns": [
        {
          "name": "keyword.other.mnemonic.nhl-65816",
          "match": "(?i)(?<![\\w.$#!<?])(?:adc|and|asl|bcc|bcs|beq|bit|bmi|bne|bpl|bra|brk|brl|bvc|bvs|clc|cld|cli|clv|cmp|cop|cpx|cpy|dec|dex|dey|eor|inc|inx|iny|jml|jmp|jsl|jsr|lda|ldx|ldy|lsr|mvn|mvp|nop|ora|pea|pei|per|pha|phb|phd|phk|php|phx|phy|pla|plb|pld|plp|plx|ply|rep|rol|ror|rti|rtl|rts|sbc|sec|sed|sei|sep|sta|stp|stx|sty|stz|tax|tay|tcd|tcs|tdc|trb|tsb|tsc|tsx|txa|txs|txy|tya|tyx|wai|wdm|xba|xce|bge|blt|cpa|dea|ina|swa|tad|tda|tas|tsa)(?:\\.[bwl])?(?![\\w])"
        }
      ]
    },
    "operand": {
      "patterns": [
        {
          "name": "storage.modifier.size.nhl-65816",
          "match": "(?<=[)\\]])\\.[bwl](?![\\w])"
        },
        {
          "name": "string.quoted.double.nhl-65816",
          "begin": "\"",
          "end": "\""
        },
        {
          "name": "variable.parameter.macro.nhl-65816",
          "match": "<[A-Za-z_][A-Za-z0-9_]*>"
        },
        {
          "name": "constant.numeric.hex.nhl-65816",
          "match": "\\$[0-9A-Fa-f]+"
        },
        {
          "name": "constant.numeric.binary.nhl-65816",
          "match": "%[01]+(?![\\w])"
        },
        {
          "name": "constant.numeric.decimal.nhl-65816",
          "match": "(?<![\\w.$])\\d+(?![\\w])"
        },
        {
          "name": "variable.language.register.nhl-65816",
          "match": "(?i)(?<![\\w.$])[axy](?![\\w])"
        },
        {
          "name": "support.constant.local-label.nhl-65816",
          "match": "(?<![\\w])[.?][A-Za-z0-9_]+"
        },
        {
          "name": "variable.other.define.nhl-65816",
          "match": "![A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "keyword.operator.nhl-65816",
          "match": "<<|>>|[-+*/&|^~#<>=]"
        },
        {
          "name": "variable.other.nhl-65816",
          "match": "[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    }
  }
}