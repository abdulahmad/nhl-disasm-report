{
  "name": "nhl-asm",
  "displayName": "NHL disassembly assembly (68000 / 65816)",
  "description": "Syntax highlighting and ctrl+click on include/incbin paths for the NHL Genesis (SNASM68K) and SNES (asar) disassembly repos. Numbers are plain numbers: nothing here is a colour.",
  "version": "1.3.1",
  "publisher": "nhl-disasm",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:nhl-m68k",
    "onLanguage:nhl-65816",
    "onLanguage:nhl-asm"
  ],
  "contributes": {
    "languages": [
      {
        "id": "nhl-m68k",
        "aliases": [
          "NHL 68000 (SNASM68K)",
          "nhl-m68k"
        ],
        "extensions": [
          ".mac68k"
        ],
        "configuration": "./language-configuration-m68k.json",
        "filenamePatterns": [
          "**/*[gG][eE][nN][eE][sS][iI][sS]*/**/*.asm",
          "**/*[gG][eE][nN][eE][sS][iI][sS]*/**/*.mac",
          "**/*[gG][eE][nN][eE][sS][iI][sS]*/**/*.inc"
        ]
      },
      {
        "id": "nhl-65816",
        "aliases": [
          "NHL 65816 (asar)",
          "nhl-65816"
        ],
        "extensions": [
          ".mac65816"
        ],
        "configuration": "./language-configuration-65816.json",
        "filenamePatterns": [
          "**/*[sS][nN][eE][sS]*/**/*.asm",
          "**/*[sS][nN][eE][sS]*/**/*.mac"
        ]
      },
      {
        "id": "nhl-asm",
        "aliases": [
          "NHL assembly (68000 + 65816)",
          "nhl-asm"
        ],
        "extensions": [
          ".mac68k"
        ],
        "configuration": "./language-configuration-asm.json"
      }
    ],
    "grammars": [
      {
        "language": "nhl-m68k",
        "scopeName": "source.nhl-m68k",
        "path": "./syntaxes/nhl-m68k.tmLanguage.json"
      },
      {
        "language": "nhl-65816",
        "scopeName": "source.nhl-65816",
        "path": "./syntaxes/nhl-65816.tmLanguage.json"
      },
      {
        "language": "nhl-asm",
        "scopeName": "source.nhl-asm",
        "path": "./syntaxes/nhl-asm.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[nhl-m68k]": {
        "editor.colorDecorators": false,
        "editor.insertSpaces": false,
        "editor.tabSize": 4,
        "editor.rulers": [
          110
        ],
        "editor.wordWrap": "off"
      },
      "[nhl-65816]": {
        "editor.colorDecorators": false,
        "editor.insertSpaces": false,
        "editor.tabSize": 4,
        "editor.rulers": [
          110
        ],
        "editor.wordWrap": "off"
      },
      "[nhl-asm]": {
        "editor.colorDecorators": false,
        "editor.insertSpaces": false,
        "editor.tabSize": 4,
        "editor.rulers": [
          110
        ],
        "editor.wordWrap": "off"
      }
    }
  }
}