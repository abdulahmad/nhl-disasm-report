{
  "comments": { "lineComment": ";" },
  "brackets": [["(", ")"], ["[", "]"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["(", ")"], ["\"", "\""], ["'", "'"]],
  "wordPattern": "(\\.?[A-Za-z_@][A-Za-z0-9_@]*)|(\\$[0-9A-Fa-f]+)|(%[01]+)|(\\d+)",
  "folding": {
    "markers": { "start": "^\\s*(?i:if|macro)\\b", "end": "^\\s*(?i:endif|endm)\\b" }
  },
  "onEnterRules": []
}
